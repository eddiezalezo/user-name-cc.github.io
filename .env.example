# --- Backend / Postgres ---
DATABASE_URL=postgresql+psycopg2://legado:legado_dev_password@postgres:5432/legado_digital
POSTGRES_USER=legado
POSTGRES_PASSWORD=legado_dev_password
POSTGRES_DB=legado_digital

# --- Auth de CUENTA (login). Nada que ver con la master password de la bóveda. ---
JWT_SECRET=CHANGE_ME_dummy_dev_secret_do_not_use_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# false SOLO para desarrollo local sobre HTTP plano (este docker-compose). En producción
# sobre HTTPS, poner en true — si no, el navegador no protege la cookie de sesión.
COOKIE_SECURE=false

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- TODO: storage S3-compatible para VaultDocument (archivos ya cifrados en cliente) ---
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=legado-digital-vault-blobs

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
